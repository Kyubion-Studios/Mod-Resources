<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>wily.legacy</groupId>
  <artifactId>legacy-neoforge</artifactId>
  <version>1.21.11-1.9-pre-1</version>
  <name>Legacy4J [Neoforge]</name>
  <description>This mod adapts all the features from old Minecraft Legacy Console Edition</description>
  <url>https://github.com/Wilyicaro/Legacy-Minecraft</url>
  <licenses>
    <license>
      <name>MPL-2</name>
      <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>wilyicaro</id>
      <name>Wilyicaro</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/Wilyicaro/Legacy-Minecraft.git</connection>
    <developerConnection>scm:git:git@github.com:Wilyicaro/Legacy-Minecraft.git</developerConnection>
    <url>https://github.com/Wilyicaro/Legacy-Minecraft</url>
  </scm>
  <issueManagement>
    <system>github</system>
    <url>https://github.com/Wilyicaro/Legacy-Minecraft/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>dev.isxander</groupId>
      <artifactId>libsdl4j</artifactId>
      <version>3.2.18.release-3.2.18-79</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>wily.factory_api</groupId>
      <artifactId>factory_api-neoforge</artifactId>
      <version>1.21.11-2.2.8</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>4.5.14</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>commons-codec</groupId>
          <artifactId>commons-codec</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpcore</artifactId>
      <version>4.4.16</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.2.10</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.moulberry</groupId>
      <artifactId>mixinconstraints</artifactId>
      <version>1.1.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
